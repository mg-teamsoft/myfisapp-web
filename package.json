{
  "name": "react-modern-onepage",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.6",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build && gh-pages-clean",
    "deploy": "GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=http.postBuffer GIT_CONFIG_VALUE_0=524288000 GIT_CONFIG_KEY_1=core.compression GIT_CONFIG_VALUE_1=0 GIT_CONFIG_KEY_2=http.version GIT_CONFIG_VALUE_2=HTTP/1.1 gh-pages -d build --dotfiles --cname myfisapp.com"
  },
  "homepage": "https://myfisapp.com",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
